# ---------- Mercado Livre ----------
# Crie o app em https://developers.mercadolivre.com.br/devcenter
#
# ML_REDIRECT_URI tem que ser IDENTICO ao "URIs de redirect" do DevCenter --
# nao parecido: identico, incluindo barra final. Divergencia nao aparece na
# hora de autorizar (quem manda ali e o DevCenter); ela so estoura na troca do
# code, com um `invalid_grant` que nao diz qual lado esta errado. O `ml-auth`
# compara os dois e avisa antes de gastar o code, que e de uso unico.
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI=https://leonardoopa.github.io/amazon_pay/callback
ML_SITE_ID=MLB
# ---------- Painel de afiliados (geracao automatica do link) ----------
# Opcional. Vazio = o bot volta ao fluxo manual do `promo link`.
#
# Nao existe API de afiliado no ML, e o link nao pode ser montado a mao. O bot
# usa o mesmo endpoint interno que o Link Builder do site chama, autenticado
# por cookie de sessao -- ou seja, vai quebrar quando o ML mexer na pagina.
#
# ML_AFFILIATE_COOKIE e o header `Cookie` inteiro, capturado no DevTools com o
# painel logado (veja o README). Ele da acesso a CONTA INTEIRA, nao so ao
# painel: nunca comite este arquivo, e recapture quando expirar.
# ML_AFFILIATE_TAG e o seu nickname de afiliado, em minusculo.
ML_AFFILIATE_COOKIE=
ML_AFFILIATE_TAG=
# Produtos reconsultados por rodada. Sem multiget no ML: e 1 chamada por produto.
# A coleta avisa no log quando trunca; suba se isso comecar a aparecer.
ML_TRACK_LIMIT=150

# ---------- Amazon Creators API ----------
# PA-API 5.0 foi aposentada em 15/05/2026. Credenciais saem do Associates Central.
AMAZON_CLIENT_ID=
AMAZON_CLIENT_SECRET=
# Endpoint de token varia por regiao/versao da credencial (veja o Associates Central)
AMAZON_TOKEN_ENDPOINT=
AMAZON_MARKETPLACE=www.amazon.com.br
AMAZON_PARTNER_TAG=

# ---------- Gemini (geracao do texto) ----------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# ---------- Entrega ----------
# cloud     = API oficial da Meta. Nao alcanca grupo comum (a Groups API da
#             Meta so serve grupo criado pelo bot, teto de 8 participantes),
#             entao ela manda pra voce e voce encaminha.
# evolution = posta direto no grupo, via Baileys. Viola os Termos da Meta e o
#             numero pareado pode ser banido -- pareie um chip secundario.
DELIVERY_BACKEND=cloud

# ---------- Evolution API (so com DELIVERY_BACKEND=evolution) ----------
# Suba com `docker compose up -d evolution`. Invente a chave abaixo: ela e a
# senha do gateway, e quem a tiver manda mensagem como o numero pareado.
EVOLUTION_API_KEY=
EVOLUTION_BASE_URL=http://localhost:8080
EVOLUTION_INSTANCE=ofertas
# Sai do `promo wa-groups` depois de parear. Termina em @g.us -- grupo nao tem
# numero de telefone, tem JID.
EVOLUTION_GROUP_JID=

# ---------- WhatsApp Cloud API (so com DELIVERY_BACKEND=cloud) ----------
# https://developers.facebook.com > app > WhatsApp > API Setup
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
# Seu numero pessoal em formato E.164 sem "+" (ex.: 5511999998888)
WHATSAPP_TO=
# Template utility aprovado, usado so quando a janela de 24h fechou
WHATSAPP_PING_TEMPLATE=ofertas_ping
WHATSAPP_TEMPLATE_LANG=pt_BR

# ---------- Regras de negocio ----------
DB_PATH=data/promos.db
# Desconto minimo (%) contra a mediana historica para virar post
MIN_DISCOUNT_PCT=15
# Dias de historico considerados na mediana
BASELINE_WINDOW_DAYS=60
# Minimo de dias distintos observados antes de confiar na mediana
MIN_OBSERVATIONS=7
# Nao repostar o mesmo produto dentro desse prazo
REPOST_COOLDOWN_DAYS=14
# Maximo de ofertas por rodada
MAX_OFFERS_PER_RUN=5
