# ---------- Mercado Livre ----------
# Crie o app em https://developers.mercadolivre.com.br/devcenter
#
# ML_REDIRECT_URI tem que ser IDENTICO ao "URIs de redirect" do DevCenter --
# nao parecido: identico, incluindo barra final. Divergencia nao aparece na
# hora de autorizar (quem manda ali e o DevCenter); ela so estoura na troca do
# code, com um `invalid_grant` que nao diz qual lado esta errado. O `ml-auth`
# compara os dois e avisa antes de gastar o code, que e de uso unico.
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI=https://leonardoopa.github.io/amazon_pay/callback
ML_SITE_ID=MLB
# ---------- Painel de afiliados (geracao automatica do link) ----------
# Opcional. Vazio = o bot volta ao fluxo manual do `promo link`.
#
# Nao existe API de afiliado no ML, e o link nao pode ser montado a mao. O bot
# usa o mesmo endpoint interno que o Link Builder do site chama, autenticado
# por cookie de sessao -- ou seja, vai quebrar quando o ML mexer na pagina.
#
# ML_AFFILIATE_COOKIE e o header `Cookie` inteiro, capturado no DevTools com o
# painel logado (veja o README). Ele da acesso a CONTA INTEIRA, nao so ao
# painel: nunca comite este arquivo, e recapture quando expirar.
# ML_AFFILIATE_TAG e o seu nickname de afiliado, em minusculo.
ML_AFFILIATE_COOKIE=
ML_AFFILIATE_TAG=
# Produtos reconsultados por rodada. Sem multiget no ML: e 1 chamada por produto.
# A coleta avisa no log quando trunca; suba se isso comecar a aparecer.
#
# Precisa acompanhar o tamanho da watchlist. O corte e `ORDER BY last_seen_at
# DESC`, nao um rodizio: quem fica de fora nao volta na rodada seguinte, fica
# sem observacao ate sumir da janela da baseline. Entao termo novo na watchlist
# sem teto novo aqui nao amplia a carteira -- so troca quem esta dentro dela.
# Isto decide quantas ofertas VERIFICADAS o grupo consegue ter. Verificada e a
# unica que pode afirmar que o preco caiu de verdade, e ela exige
# MIN_OBSERVATIONS dias distintos de historico -- que so acontece para quem e
# reconsultado. Produto fora do teto para de acumular historico e nunca chega
# la. Medido em 01/09/2026: 1.923 produtos de catalogo com teto de 900, e os
# 1.023 de fora incluiam ofertas que passariam no filtro AGORA, com queda real
# de 18% a 29% contra a nossa propria mediana.
# Producao: 2000 para 191 termos e 34 categorias (~400s de reconsulta por hora).
ML_TRACK_LIMIT=150

# ---------- Amazon Creators API ----------
# PA-API 5.0 foi aposentada em 15/05/2026. Credenciais saem do Associates Central.
AMAZON_CLIENT_ID=
AMAZON_CLIENT_SECRET=
# Endpoint de token varia por regiao/versao da credencial (veja o Associates Central)
AMAZON_TOKEN_ENDPOINT=
AMAZON_MARKETPLACE=www.amazon.com.br
AMAZON_PARTNER_TAG=

# ---------- Gemini (geracao do texto) ----------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# ---------- Entrega ----------
# cloud     = API oficial da Meta. Nao alcanca grupo comum (a Groups API da
#             Meta so serve grupo criado pelo bot, teto de 8 participantes),
#             entao ela manda pra voce e voce encaminha.
# evolution = posta direto no grupo, via Baileys. Viola os Termos da Meta e o
#             numero pareado pode ser banido -- pareie um chip secundario.
DELIVERY_BACKEND=cloud

# ---------- Evolution API (so com DELIVERY_BACKEND=evolution) ----------
# Suba com `docker compose up -d evolution`. Invente a chave abaixo: ela e a
# senha do gateway, e quem a tiver manda mensagem como o numero pareado.
EVOLUTION_API_KEY=
EVOLUTION_BASE_URL=http://localhost:8080
EVOLUTION_INSTANCE=ofertas
# Sai do `promo wa-groups` depois de parear. Termina em @g.us -- grupo nao tem
# numero de telefone, tem JID.
EVOLUTION_GROUP_JID=

# ---------- WhatsApp Cloud API (so com DELIVERY_BACKEND=cloud) ----------
# https://developers.facebook.com > app > WhatsApp > API Setup
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
# Seu numero pessoal em formato E.164 sem "+" (ex.: 5511999998888)
WHATSAPP_TO=
# Template utility aprovado, usado so quando a janela de 24h fechou
WHATSAPP_PING_TEMPLATE=ofertas_ping
WHATSAPP_TEMPLATE_LANG=pt_BR

# ---------- API HTTP (comando `serve`, padrao do container) ----------
# O /health e aberto (e o healthcheck do compose) e nao devolve segredo.
# /stats e /run exigem o header X-API-Key com o valor de API_SECRET.
#
# API_SECRET vazio NAO deixa os endpoints abertos: eles respondem 503. Falha
# fechada de proposito -- /run gasta cota do Gemini e dispara post no grupo.
# Gere com: openssl rand -hex 32
API_SECRET=
# Interface onde a API escuta. Deixe 127.0.0.1 fora do Docker; o Dockerfile
# sobrescreve pra 0.0.0.0, e quem restringe o acesso e o bind do compose.
API_HOST=127.0.0.1
API_PORT=8000
# false = a API sobe sem o loop de coleta. So use se houver um `daemon`
# separado; com SQLite, nunca os dois no mesmo arquivo ao mesmo tempo.
API_WORKER=true
# Segundos entre rodadas do loop (padrao 2h)
RUN_INTERVAL_SECONDS=7200

# ---------- Regras de negocio ----------
DB_PATH=data/promos.db
# Desconto minimo (%) contra a mediana historica para virar post
MIN_DISCOUNT_PCT=15
# Economia minima em REAIS. 0 desliga. Producao usa 10.
#
# Porcentagem sozinha nao ve dinheiro. Dois posts reais em 02/09/2026:
#
#     Tasty Whey 3w Gourmet 912g   de R$ 239,00 por R$ 237,00   -0,8%
#     Perfume Club De Nuit Armaf   de R$ 197,34 por R$ 197,34    0,0%
#
# Este piso e absoluto e NAO e afrouxado por tema prioritario -- foi justamente
# com PRIORITY_MIN_DISCOUNT_PCT=0 que o primeiro passou. Medido nos 200 posts
# anteriores: cortaria 7 deles (3,5%), e nenhum dos bons baratos, que
# economizam de R$ 14 para cima.
MIN_DISCOUNT_BRL=0
# Piso proprio da oferta VERIFICADA, em %. Vazio usa MIN_DISCOUNT_PCT.
# Producao usa 15.
#
# A verificada e a unica que afirma "acompanhamos o preco e ele caiu", e a
# frase precisa de um numero que a sustente. O piso e separado porque
# PRIORITY_MIN_DISCOUNT_PCT zera o geral nos temas prioritarios, e foi assim
# que passaram -0,8% e 0,0%. `regras_do_tema` so mexe em MIN_DISCOUNT_PCT.
#
# Medido em 02/09/2026, sobre 1.229 produtos maduros e com o piso de R$ 10:
#
#     piso  0%   37 verificadas passariam
#     piso  5%   29
#     piso 10%   22
#     piso 15%   15
#     piso 20%   11
#
# O repasse da vitrine NAO usa este piso: ele nao afirma medicao nenhuma,
# so repete o riscado da loja, e apertar la cortaria volume sem ganhar
# honestidade.
MIN_DISCOUNT_PCT_VERIFIED=
# Dias de historico considerados na mediana
BASELINE_WINDOW_DAYS=60
# Minimo de dias distintos observados antes de confiar na mediana.
#
# E o preco de entrada da oferta VERIFICADA, a unica que pode afirmar que o
# preco caiu de verdade. Producao usa 3. Medido em 02/09/2026, na mesma
# carteira e no mesmo instante:
#
#     MIN_OBSERVATIONS=4   339 produtos maduros, 14 ofertas passariam
#     MIN_OBSERVATIONS=3  1199 produtos maduros, 49 ofertas passariam
#
# O que se paga por isso: com tres pontos, a mediana e o do meio, e basta um
# dia de preco inflado entre os outros dois para a baseline subir junto. Nao
# baixe para 2 -- com dois pontos nao existe mediana, so media de um par, e a
# afirmacao "acompanhamos o preco" deixa de ter lastro.
MIN_OBSERVATIONS=7
# Nao repostar o mesmo produto dentro desse prazo
REPOST_COOLDOWN_DAYS=14
# Maximo de ofertas por rodada
MAX_OFFERS_PER_RUN=5

# ---------- Site (landing + vitrine, em web/) ----------
# Deixe 1 SO na sua maquina. O padrao e 0, e em producao com 1 qualquer
# visitante ve traceback com settings e trecho de banco.
DJANGO_DEBUG=1
# Obrigatoria quando DJANGO_DEBUG=0 -- o site se recusa a subir sem ela.
# Gere com: openssl rand -hex 32
DJANGO_SECRET_KEY=
# Dominios que o site aceita responder, separados por virgula. Obrigatorio
# fora do DEBUG: sem isso o site responderia a qualquer Host.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Com esquema, senao o POST do formulario de e-mail leva 403 atras de HTTPS.
# Ex.: https://ofertas.seudominio.com.br
DJANGO_CSRF_TRUSTED_ORIGINS=
# 1 somente depois que houver certificado na frente. Liga redirect para
# HTTPS, cookie Secure e HSTS -- com 1 sem TLS, o site fica inalcancavel.
DJANGO_HTTPS=0
# Prazo do HSTS. Comece curto: o navegador guarda o valor recebido e nao ha
# como encurtar depois. Suba para 31536000 apos uma semana de TLS estavel.
DJANGO_HSTS_SECONDS=3600
# Banco do site (grupos e inscritos). Fica em data/ para viver no volume.
DJANGO_DB_PATH=data/site.db
# Endereco que o Caddy publica. `:80` serve por IP sem TLS (so para testar);
# um dominio liga certificado automatico.
SITE_ADDRESS=:80

# ---------- Fila de posts ----------
# Idade maxima de um post na fila antes de ser descartado como `expired`.
# O texto carrega um preco com hora, e o gotejamento pode segurar a fila por
# mais de uma hora: mandar valor que o link nao confirma mais custa mais do
# que a oferta perdida. 0 desliga o descarte.
POST_MAX_AGE_MINUTES=60

# Faixa de preco onde esta o foco do grupo. 0 desliga o foco.
#
# NAO e teto: produto caro continua entrando. E prioridade -- as vagas da
# rodada vao primeiro para o que esta ate aqui.
#
# O motivo e de publico, nao de qualidade: quem le grupo de oferta decide um
# item de R$ 100 na hora e um de R$ 1.000 em dias, e nesses dias sai do grupo,
# pesquisa e compra por outro link.
PRICE_FOCUS_MAX=300
# Vagas da rodada abertas a QUALQUER preco. Sem elas, um dia com muitos
# candidatos baratos empurraria o produto caro para fora todas as vezes, e o
# grupo perderia a variedade de faixa que segura audiencia.
PRICE_FOCUS_RESERVE=1

# Vagas guardadas para os temas do `priority` no watchlist.json. 0 desliga.
#
# Desconto e preco decidem por numero, e o numero maior costuma vir de outra
# categoria: com 132 termos na watchlist, os 252 produtos novos de cabelo e
# pele nao pegaram nenhuma das 5 vagas da primeira rodada -- ficaram com -72%,
# -67% e -54%. Publico nao aparece na ordenacao, entao guarda-se vaga.
#
# E teto, nao piso: sem candidato do tema, nenhuma vaga fica vazia.
PRIORITY_RESERVE=0
# Piso de desconto so nos temas prioritarios. Vazio usa MIN_DISCOUNT_PCT.
# A conta e outra la: -9% num shampoo de salao de R$ 400 e mais dinheiro que
# -60% num item de R$ 25, e quem entrou no grupo pelo nome do produto ja o quer.
# Zero deixa passar qualquer desconto, mas nao "nenhum desconto" -- sem preco
# riscado maior que o atual continua nao havendo oferta.
PRIORITY_MIN_DISCOUNT_PCT=
# Desliga PRICE_FOCUS_MAX dentro da reserva, para o item caro do tema nao
# perder a vaga para o barato do mesmo tema.
PRIORITY_IGNORES_PRICE_FOCUS=0
# Nos temas prioritarios, a oferta sai da LOJA OFICIAL em vez do vendedor mais
# barato. Sao marcas de salao e dermocosmetico, e o vendedor avulso barato e
# onde mora a falsificacao. Medido em 13 produtos dos temas: 12 tem anuncio de
# loja oficial e o sobrepreco mediano e ZERO. Sem loja oficial, cai na regra
# geral em vez de sumir.
PREFER_OFFICIAL_STORE=0

# Silencio minimo entre dois posts do MESMO produto, em minutos.
#
# A vitrine do ML devolve o mesmo item rodada apos rodada enquanto ele seguir
# em promocao, e o filtro aprova de novo -- o desconto continua real. Do lado
# do grupo, o segundo post em quinze minutos nao e oferta nova: e a mesma,
# repetida. Post ainda na fila bloqueia mesmo com 0 aqui.
#
# Nao se confunde com a variacao de texto: isto olha o PRODUTO, e a chamada
# repetida e barrada no proprio copywriter.
#
# 60 era apertado demais. Medido em 01/09/2026, com a janela em 60: o mesmo
# "Jogo De Lencol Queen Micropercal 400 Fios" saiu a R$ 30,00 e, 76 minutos
# depois, a R$ 30,55. Preco quase igual e pior que repeticao simples -- parece
# que o grupo nao sabe o preco. Producao usa 180: a carteira passou de 2.600
# produtos, entao esperar tres horas nao custa volume nenhum.
POST_COOLDOWN_MINUTES=60

# ---------- Janela de silencio ----------
# De madrugada o post nao e lido: ele acorda gente e fica no topo da tela ate
# de manha, quando o preco ja envelheceu. Dentro desta faixa o bot posta muito
# menos, sem parar de todo.
#
# Hora local do servidor -- o Dockerfile fixa TZ=America/Sao_Paulo. A faixa
# pode cruzar a meia-noite, que e o caso normal. Deixar QUALQUER um dos dois
# vazio desliga a janela; apagar a linha volta ao padrao abaixo.
QUIET_START=23:30
QUIET_END=07:30
# Quanto o intervalo entre posts estica dentro da janela. 6 x 150s = 900s,
# acima do orcamento de drenagem de uma rodada -- na pratica um post por
# rodada, contra os cinco de fora da janela.
QUIET_DRIP_MULTIPLIER=6
# Teto de ofertas novas por rodada dentro da janela. Sem ele a coleta seguiria
# produzindo no ritmo normal enquanto a entrega anda devagar, e a diferenca
# inteira morreria como `expired` de manha -- Gemini e link de afiliado
# gastos para nada.
QUIET_MAX_OFFERS_PER_RUN=1
